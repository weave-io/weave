{
  "$schema": "../node_modules/@microsoft/api-extractor/lib/schemas/api-extractor.schema.json",
  "compiler": {
    "skipLibCheck": true
  },
  "apiReport": {
    "enabled": false
  },
  "docModel": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": true
  },
  "messages": {
    "compilerMessageReporting": {
      "default": {
        "logLevel": "error"
      }
    },
    "extractorMessageReporting": {
      "ae-forgotten-export": {
        "logLevel": "none"
      },
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "default": {
        "logLevel": "error"
      }
    },
    "tsdocMessageReporting": {
      "tsdoc-malformed-inline-tag": {
        "logLevel": "none"
      },
      "tsdoc-escape-right-brace": {
        "logLevel": "none"
      },
      "default": {
        "logLevel": "error"
      }
    }
  }
}
