{
  "name": "@weaveio/weave-adapter-opencode2",
  "version": "0.0.1",
  "private": true,
  "description": "OpenCode V2 plugin adapter for the Weave orchestration framework",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "bun ../../../scripts/build-public-packages.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "verify:opencode2": "bash verify/run.sh"
  },
  "dependencies": {
    "@opencode-ai/client": "0.0.0-beta-19151",
    "@opencode-ai/plugin": "0.0.0-beta-19151",
    "@opencode-ai/sdk": "0.0.0-beta-19151",
    "mustache": "^4.2.0",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@weaveio/weave-config": "workspace:*",
    "@weaveio/weave-core": "workspace:*",
    "@weaveio/weave-engine": "workspace:*",
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weave-io/weave"
  }
}
