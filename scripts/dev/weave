#!/usr/bin/env bash
# scripts/dev/weave
#
# Run the Weave CLI from this checkout's source, from any directory:
#
#   ~/source/weave/scripts/dev/weave validate
#   ~/source/weave/scripts/dev/weave init migrate --scope local
#
# No build step. `weave --version` reports the checkout's version with a
# `-dev` suffix so it can't be mistaken for an installed release.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CLI_PKG="${REPO_ROOT}/packages/cli/package.json"

version="$(bun -e 'console.log((await Bun.file(process.argv[1]).json()).version)' "${CLI_PKG}")"
export WEAVE_CLI_VERSION="${version}-dev"
exec bun "${REPO_ROOT}/packages/cli/src/main.ts" "$@"
