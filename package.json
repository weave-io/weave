{
  "name": "@weaveio/weave",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/engine",
    "packages/config",
    "packages/cli",
    "packages/docs",
    "packages/adapters/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "changeset:check": "bun scripts/release/changeset-policy.ts",
    "docs:dev": "bun run --filter '@weaveio/weave-docs' dev",
    "docs:build": "bun run --filter '@weaveio/weave-docs' build",
    "docs:preview": "bun run --filter '@weaveio/weave-docs' preview",
    "docs:check-links": "bun scripts/docs/check-links.ts",
    "validate-config": "bun packages/cli/src/main.ts validate --project",
    "build": "bun scripts/build-public-packages.ts && bun run --filter '@weaveio/weave-docs' build",
    "test": "bun run --filter '*' test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && bun run --filter '*' typecheck",
    "lint": "biome lint packages/ scripts/ config/ biome.json package.json tsconfig.json scripts/tsconfig.json && bun run validate:declarations",
    "verify:action-pins": "bun scripts/ci/verify-action-pins.ts",
    "verify:codeowners": "bun scripts/ci/verify-codeowners.ts",
    "validate:declarations": "bun scripts/validate-api-extractor-configs.ts",
    "clean": "find . -type d -name dist -not -path '*/node_modules/*' | xargs rm -rf",
    "version": "changeset version",
    "release:dry": "bun run build && bun run release:control:build",
    "release:control:build": "bun scripts/build-release-control.ts",
    "release:control:clean-room": "bun scripts/release/clean-room.ts",
    "release:dry:nightly": "bun scripts/release/dry-run-nightly.ts",
    "release:dry:stable": "bun scripts/release/dry-run-stable.ts",
    "release:validate": "bun run build && bun scripts/release/packager.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/cli": "^2.31.0",
    "@microsoft/api-extractor": "^7.55.1",
    "bun-types": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "neverthrow": "^8.2.0",
    "typescript": "^5.4.5",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weave-io/weave"
  }
}
