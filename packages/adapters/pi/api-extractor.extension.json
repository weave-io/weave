{
  "extends": "../../../config/api-extractor.base.json",
  "mainEntryPointFilePath": "<projectFolder>/dist-types/extension.d.ts",
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.build.json"
  },
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/temp/",
    "reportFileName": "weave-adapter-pi-extension"
  },
  "dtsRollup": {
    "publicTrimmedFilePath": "<projectFolder>/dist/extension.d.ts",
    "untrimmedFilePath": "<projectFolder>/dist-types/untrimmed-extension.d.ts"
  },
  "bundledPackages": [
    "@weaveio/weave-core",
    "@weaveio/weave-config",
    "@weaveio/weave-engine"
  ]
}
